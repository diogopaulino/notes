{
  "name": "notes",
  "private": false,
  "version": "1.0.0",
  "description": "A beautiful Apple Notes–inspired desktop app. Simple, fast, offline.",
  "license": "MIT",
  "author": "Notes contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/diogopaulino/notes.git"
  },
  "keywords": [
    "notes",
    "electron",
    "react",
    "macos",
    "apple-notes",
    "offline"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "pack": "npm run build && electron-builder --mac",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "app.notes.desktop",
    "productName": "Notes",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.icns",
        "to": "icon.icns"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Notes",
      "icon": "build/icon.icns",
      "iconSize": 128,
      "contents": [
        {
          "x": 160,
          "y": 180,
          "type": "file"
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 580,
        "height": 400
      }
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
